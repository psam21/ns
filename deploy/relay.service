[Unit]
Description=nostr.ltd Nostr Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=relay
Group=relay
WorkingDirectory=/opt/relay
ExecStart=/opt/relay/relay-arm64 start --config /opt/relay/config.yaml
Restart=always
RestartSec=5
LimitNOFILE=65535

# Hard stop deadline. The binary escalates to a hard exit after 20s, so 30s
# here is the backstop for the case where the process cannot even run that
# timer. This replaces the 90s systemd default, which is far longer than any
# useful shutdown and turns every restart into a 90s outage.
TimeoutStopSec=30
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes

# Go GC tuning. Without GOMEMLIMIT the Go 1.19+ runtime has no awareness of
# cgroup limits and sizes its heap purely from live heap via GOGC=100, so on a
# 1.8GB host it will happily grow toward MemoryHigh and start swapping — which
# is how the relay reached MemoryHigh=768M with 928M of swap and wedged on
# 2026-10-02 (threads in D state, accept backlog at Recv-Q 2624, zero bytes
# served, systemd still reporting "active (running)").
#
# Set a soft limit comfortably below MemoryHigh so the GC becomes aggressive
# well before the cgroup starts reclaiming, giving the process a chance to
# shed garbage instead of blocking on page-in. 512M against MemoryHigh=768M
# leaves headroom for non-heap allocations (stacks, the 11.4MB bloom filter,
# cgo/pg buffers) that are not counted against GOMEMLIMIT.
#
# This is a guardrail, not the fix. The per-connection cost was cut 256x in
# 4da537e (1MB -> 4KB buffers) and measured at ~20KB/connection under a
# 300-connection test on 2026-10-02, so the primary fix remains bounded
# buffers and non-blocking dashboard queries.
Environment=GOMEMLIMIT=512MiB

# Memory guardrails. The relay has been OOM-killed by the system OOM
# killer during heavy dashboard refresh windows (observed 2026-09-02).
# MemoryMax triggers a clean systemd restart before the system OOM
# killer fires; MemoryHigh triggers a slower allocation backpressure.
# These are guardrails, not the primary fix — the primary fix is
# bounded caches and single-flight refreshes in the code.
MemoryHigh=768M
MemoryMax=1G

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/relay /opt/relay
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Environment
Environment=HOME=/opt/relay
EnvironmentFile=/opt/relay/.env

[Install]
WantedBy=multi-user.target
