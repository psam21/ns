{
  "name": "blossom-server-ts",
  "version": "5.2.0",
  "description": "A blossom server implementation written in Typescript",
  "main": "build/index.js",
  "type": "module",
  "author": "hzrd149",
  "license": "MIT",
  "scripts": {
    "prepublish": "pnpm build",
    "start": "node build/index.js",
    "build": "tsc",
    "postbuild": "cd admin && pnpm install --frozen-lockfile && pnpm build",
    "dev": "nodemon -i '**/data/**' -i '**/database.json' -i '**/database.old.json' --exec 'node' --loader @swc-node/register/esm src/index.ts",
    "test": "tsc && node --test 'src/**/*.test.mjs'",
    "format": "prettier -w ."
  },
  "bin": "build/index.js",
  "files": [
    "build",
    "public",
    "admin/dist"
  ],
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.0",
    "@nostr-dev-kit/ndk": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "blossom-server-sdk": "^0.8.0",
    "dayjs": "^1.11.23",
    "debug": "^4.4.3",
    "file-type": "^22.0.2",
    "fluent-ffmpeg": "^2.1.3",
    "follow-redirects": "^1.16.0",
    "generate-password": "^1.7.1",
    "http-errors": "^2.0.1",
    "koa": "^3.2.1",
    "koa-basic-auth": "^4.0.0",
    "koa-body": "^8.0.0",
    "koa-mount": "^4.2.0",
    "koa-range": "^0.3.0",
    "koa-static": "^5.0.0",
    "lilconfig": "^3.1.3",
    "mime": "^4.1.0",
    "minio": "^8.0.7",
    "mkdirp": "^3.0.1",
    "nanoid": "^6.0.1",
    "nostr-tools": "^2.24.3",
    "sharp": "^0.35.3",
    "socks-proxy-agent": "^10.1.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.1",
    "@swc/types": "^0.1.28",
    "@types/better-sqlite3": "^9.6.0",
    "@types/debug": "^4.1.13",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/follow-redirects": "^1.14.4",
    "@types/http-errors": "^2.0.5",
    "@types/koa": "^3.0.3",
    "@types/koa-basic-auth": "^2.0.7",
    "@types/koa-mount": "^4.0.5",
    "@types/koa-range": "^0.3.6",
    "@types/koa-static": "^4.0.4",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "^12.0.5",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@9.12.0"
}
